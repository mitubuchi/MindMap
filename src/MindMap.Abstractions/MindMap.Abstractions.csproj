<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      パッケージが参照する唯一のアセンブリ。ホスト（MindMap.exe）より低い
      プラットフォーム版を狙うことで、パッケージ側は net9.0-windows のままで書ける。

      ビューアは画面そのものを返すので WPF への参照が要る。ツールも自前のダイアログを
      出せるよう親ウィンドウを受け取る。ここを分けずに 1 つにしているのは、
      この規模で「UI 無しの契約」を別に切っても使い道が無いため。
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>MindMap.Abstractions</AssemblyName>
    <RootNamespace>MindMap.Abstractions</RootNamespace>
    <Product>MindMap</Product>
    <Company>MindMap</Company>
    <Copyright>Copyright © 2026</Copyright>

    <!--
      パッケージの互換判定に使う版。契約を壊す変更をしたときだけ上げる。
      アプリの版（MindMap.csproj の Version）とは別に動かす。
    -->
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
