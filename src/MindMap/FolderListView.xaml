<UserControl x:Class="MindMap.FolderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MindMap.Converters"
             xmlns:viewers="clr-namespace:MindMap.Services.Viewers">

    <!--
        フォルダーの中身の一覧。桁は Grid の列に任せる（文字を詰めて揃えると、
        日本語の名前が入ったときに書体しだいでずれる）。

        名前の左のアイコンは、ノードの脇で使っているものと同じ LinkGlyph。
        行の DataContext が Link を持っているのでそのまま効き、
        キャンバス上のアイコンと必ず同じ絵柄になる。
    -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <DockPanel Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,6"
                       FontSize="11"
                       Foreground="#5B6673"
                       Text="{Binding Summary}" />

            <!-- 数が多いフォルダーでも重くならないよう、見えている行だけ作る。 -->
            <ListBox ItemsSource="{Binding Entries}"
                     Grid.IsSharedSizeScope="True"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     KeyDown="List_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="BorderThickness" Value="0" />
                        <!-- 行そのものに付ける。余白をダブルクリックしても何も起きないように。 -->
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewers:FolderEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Modified" />
                            </Grid.ColumnDefinitions>

                            <!-- 線画は 16、アプリのアイコンは 18 で幅が違う。
                                 揃えないと名前の開始位置が行ごとに 2px ずれる。 -->
                            <ContentControl Style="{StaticResource LinkGlyph}"
                                            Width="18"
                                            VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Margin="6,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}"
                                       ToolTip="{Binding Link}" />

                            <TextBlock Grid.Column="2"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       Foreground="#5B6673"
                                       Text="{Binding Size}" />

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#8A94A0"
                                       Text="{Binding Modified}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 空・権限が無いなど、一覧を出せないとき。 -->
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="#8A94A0"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}" />
    </Grid>
</UserControl>
