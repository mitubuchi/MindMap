<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>MindMap</AssemblyName>
    <Product>MindMap</Product>
    <Company>MindMap</Company>
    <Version>1.7.0</Version>
    <FileVersion>1.7.0.0</FileVersion>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <Copyright>Copyright © 2026 Keiji Mitsubuchi / Virtual IP Production</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.WPF" Version="23.2.28" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- パッケージと共有する契約。パッケージ側も同じアセンブリを参照する。 -->
    <ProjectReference Include="..\MindMap.Abstractions\MindMap.Abstractions.csproj" />
  </ItemGroup>

</Project>
