<Window x:Class="MindMap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MindMap.Converters"
        xmlns:vm="clr-namespace:MindMap.ViewModels"
        Title="設定"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontSize="13">

    <Window.Resources>
        <conv:EmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />

        <!--
            設定 1 つぶんの入力欄。種類ごとにテンプレートを分け、下の ContentControl で選ぶ。
            種類を増やすときは、ここにテンプレートを 1 つ足して、選ぶ側に DataTrigger を 1 つ足す。
        -->
        <DataTemplate x:Key="SettingEditor.Text">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     VerticalContentAlignment="Center" />
        </DataTemplate>

        <!-- フォルダーとファイルは、脇に参照ボタンが付くだけで同じ形。 -->
        <DataTemplate x:Key="SettingEditor.Path">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="参照..."
                        Margin="8,0,0,0"
                        Padding="14,4"
                        Command="{Binding DataContext.BrowseCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- 入切は見出しを持たない（チェックボックスの文言がそのまま見出しになる）。 -->
        <DataTemplate x:Key="SettingEditor.Bool">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding Flag, Mode=TwoWay}"
                      VerticalContentAlignment="Center" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      MaxHeight="520"
                      VerticalScrollBarVisibility="Auto"
                      Padding="22,20,22,4">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingItemViewModel}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource SettingEditor.Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                                <Setter Property="ContentTemplate"
                                                        Value="{StaticResource SettingEditor.Path}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="File">
                                                <Setter Property="ContentTemplate"
                                                        Value="{StaticResource SettingEditor.Path}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                                <Setter Property="ContentTemplate"
                                                        Value="{StaticResource SettingEditor.Bool}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <TextBlock Text="{Binding Description}"
                                       Foreground="#777"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding Description, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 書き込み先を出しておく。テキストエディタで直したい人が場所を探さずに済む。 -->
        <Border Grid.Row="1"
                Background="#F4F6F8"
                BorderBrush="#DDE2E7"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding FilePath}"
                           ToolTip="{Binding FilePath}"
                           Foreground="#777"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="OK"
                            IsDefault="True"
                            MinWidth="88"
                            Padding="12,5"
                            Command="{Binding OkCommand}" />
                    <Button Content="キャンセル"
                            IsCancel="True"
                            MinWidth="88"
                            Padding="12,5"
                            Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
