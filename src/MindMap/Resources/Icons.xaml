<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        アイコンはすべて 24x24 を基準にした線画。塗りではなく線で描いているのは、
        小さく表示しても形が潰れにくく、色を 1 か所で変えられるため。
    -->

    <PathGeometry x:Key="Icon.New" Figures="M7,3 H14 L19,8 V21 H7 Z M14,3 V8 H19" />

    <PathGeometry x:Key="Icon.Open" Figures="M3,7 H10 L12,9 H21 V20 H3 Z" />

    <PathGeometry x:Key="Icon.Save" Figures="M4,4 H16 L20,8 V20 H4 Z M8,4 V9 H15 V4 M7,20 V14 H17 V20" />

    <!-- 名前を付けて保存：受け皿に矢印を落とす形 -->
    <PathGeometry x:Key="Icon.SaveAs" Figures="M12,3 V15 M7.5,10.5 L12,15 L16.5,10.5 M4,18 V21 H20 V18" />

    <PathGeometry x:Key="Icon.Undo" Figures="M8,8 H14 A5,5 0 0 1 14,18 H9 M8,8 L11.5,4.5 M8,8 L11.5,11.5" />

    <PathGeometry x:Key="Icon.Redo" Figures="M16,8 H10 A5,5 0 0 0 10,18 H15 M16,8 L12.5,4.5 M16,8 L12.5,11.5" />

    <!-- 子ノード：横に枝を伸ばした先に + の付いた箱 -->
    <PathGeometry x:Key="Icon.AddChild"
                  Figures="M3,9 H9 V15 H3 Z M9,12 H15 M15,7 H21 V17 H15 Z M18,10 V14 M16,12 H20" />

    <!-- 兄弟ノード：下に枝を伸ばした先に + の付いた箱 -->
    <PathGeometry x:Key="Icon.AddSibling"
                  Figures="M8,3 H16 V8 H8 Z M12,8 V13 M6,13 H18 V21 H6 Z M12,15 V19 M10,17 H14" />

    <PathGeometry x:Key="Icon.Edit" Figures="M4,20 V16 L16,4 L20,8 L8,20 Z M14,6 L18,10" />

    <PathGeometry x:Key="Icon.Delete"
                  Figures="M4,7 H20 M9,7 V4 H15 V7 M6,7 V20 H18 V7 M10,11 V17 M14,11 V17" />

    <PathGeometry x:Key="Icon.ZoomOut"
                  Figures="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21 M8,11 H14" />

    <PathGeometry x:Key="Icon.ZoomIn"
                  Figures="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21 M8,11 H14 M11,8 V14" />

    <!-- 等倍に戻す：枠の中に枠 -->
    <PathGeometry x:Key="Icon.ZoomReset" Figures="M4,5 H20 V19 H4 Z M9,9 H15 V15 H9 Z" />

    <PathGeometry x:Key="Icon.Close" Figures="M5,5 L15,15 M15,5 L5,15" />

    <!-- リンク：枠の外に飛び出す矢印 -->
    <PathGeometry x:Key="Icon.Link" Figures="M13,4 H20 V11 M20,4 L11,13 M17,14 V20 H4 V7 H10" />

    <!-- ノードのタイトル脇に出すリンクボタン。 -->
    <Style x:Key="NodeLinkButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <Path x:Name="Glyph"
                              Data="{StaticResource Icon.Link}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="#2F80ED"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#E4EEFC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ツールバーのアイコン。ボタンが無効なときは一緒に淡くする。 -->
    <Style x:Key="ToolBarIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="#3C4652" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                         Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ツールバーのボタン。アイコンは Tag に、文字は Content に入れる。
        ボタンごとに StackPanel を書かずに済ませるため、中身の並べ方はここで一度だけ決める。
        ToolBar は中のボタンに専用のスタイルを当てるので、それを継承しないと
        ツールバーらしい見た目が失われる。各ボタンで明示的に指定して使う。
    -->
    <Style x:Key="ToolBarButton"
           TargetType="Button"
           BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolBarIcon}"
                              Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タブを閉じるボタン。ふだんは控えめに、ホバーで背景を出す。 -->
    <Style x:Key="TabCloseButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <Path x:Name="Glyph"
                              Data="{StaticResource Icon.Close}"
                              Width="9"
                              Height="9"
                              Stretch="Uniform"
                              Stroke="#8A94A0"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#DDE3EA" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="#3C4652" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#C3CBD5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
