<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MindMap.Converters"
                    xmlns:svc="clr-namespace:MindMap.Services">

    <!-- リンク先がファイルのとき、関連付けられたアプリのアイコンを引く。 -->
    <conv:LinkIconConverter x:Key="LinkIcon" />

    <!-- リンク先の種類。Web・フォルダー・マインドマップは下の線画アイコンで出す。 -->
    <conv:LinkKindConverter x:Key="LinkKind" />

    <!--
        アイコンはすべて 24x24 を基準にした線画。塗りではなく線で描いているのは、
        小さく表示しても形が潰れにくく、色を 1 か所で変えられるため。
    -->

    <PathGeometry x:Key="Icon.New" Figures="M7,3 H14 L19,8 V21 H7 Z M14,3 V8 H19" />

    <PathGeometry x:Key="Icon.Open" Figures="M3,7 H10 L12,9 H21 V20 H3 Z" />

    <PathGeometry x:Key="Icon.Save" Figures="M4,4 H16 L20,8 V20 H4 Z M8,4 V9 H15 V4 M7,20 V14 H17 V20" />

    <!-- 名前を付けて保存：受け皿に矢印を落とす形 -->
    <PathGeometry x:Key="Icon.SaveAs" Figures="M12,3 V15 M7.5,10.5 L12,15 L16.5,10.5 M4,18 V21 H20 V18" />

    <!-- すべて保存：保存の形を 2 枚重ねて「複数まとめて」を表す -->
    <PathGeometry x:Key="Icon.SaveAll"
                  Figures="M8,3 H20 V16 H17 M3,7 H14 L17,10 V21 H3 Z M7,7 V11 H13 V7 M6,21 V16 H14 V21" />

    <PathGeometry x:Key="Icon.Undo" Figures="M8,8 H14 A5,5 0 0 1 14,18 H9 M8,8 L11.5,4.5 M8,8 L11.5,11.5" />

    <PathGeometry x:Key="Icon.Redo" Figures="M16,8 H10 A5,5 0 0 0 10,18 H15 M16,8 L12.5,4.5 M16,8 L12.5,11.5" />

    <!-- 子ノード：横に枝を伸ばした先に + の付いた箱 -->
    <PathGeometry x:Key="Icon.AddChild"
                  Figures="M3,9 H9 V15 H3 Z M9,12 H15 M15,7 H21 V17 H15 Z M18,10 V14 M16,12 H20" />

    <!-- 兄弟ノード：下に枝を伸ばした先に + の付いた箱 -->
    <PathGeometry x:Key="Icon.AddSibling"
                  Figures="M8,3 H16 V8 H8 Z M12,8 V13 M6,13 H18 V21 H6 Z M12,15 V19 M10,17 H14" />

    <!-- 切り取り：交差する 2 枚の刃と、下の 2 つの持ち手 -->
    <PathGeometry x:Key="Icon.Cut"
                  Figures="M6,3 L15,16 M18,3 L9,16 M4,19.5 A2.5,2.5 0 1 0 9,19.5 A2.5,2.5 0 1 0 4,19.5
                           M15,19.5 A2.5,2.5 0 1 0 20,19.5 A2.5,2.5 0 1 0 15,19.5" />

    <!-- コピー：同じ紙が 2 枚重なった形 -->
    <PathGeometry x:Key="Icon.Copy" Figures="M9,3 H20 V15 H16 M4,8 H16 V21 H4 Z" />

    <!-- 貼り付け：クリップボードに紙をはさんだ形 -->
    <PathGeometry x:Key="Icon.Paste"
                  Figures="M9,4 H5 V21 H19 V4 H15 M9,2.5 H15 V6 H9 Z M8,11 H16 M8,15 H16" />

    <!--
        子ノードの整列。左の四角が親、その右（下）に並ぶ棒が子。
        縦は親の右に縦一列、横は親の下に横一列、という並び方をそのまま形にしてある。
    -->
    <PathGeometry x:Key="Icon.ArrangeVertical"
                  Figures="M3,10 H7 V14 H3 Z M11,5 H21 M11,12 H21 M11,19 H21" />

    <PathGeometry x:Key="Icon.ArrangeHorizontal"
                  Figures="M10,3 H14 V7 H10 Z M5,11 V21 M12,11 V21 M19,11 V21" />

    <PathGeometry x:Key="Icon.Edit" Figures="M4,20 V16 L16,4 L20,8 L8,20 Z M14,6 L18,10" />

    <PathGeometry x:Key="Icon.Delete"
                  Figures="M4,7 H20 M9,7 V4 H15 V7 M6,7 V20 H18 V7 M10,11 V17 M14,11 V17" />

    <PathGeometry x:Key="Icon.ZoomOut"
                  Figures="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21 M8,11 H14" />

    <PathGeometry x:Key="Icon.ZoomIn"
                  Figures="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M16,16 L21,21 M8,11 H14 M11,8 V14" />

    <!-- 等倍に戻す：枠の中に枠 -->
    <PathGeometry x:Key="Icon.ZoomReset" Figures="M4,5 H20 V19 H4 Z M9,9 H15 V15 H9 Z" />

    <!-- ビューア：画面を分けて、右側に中身を出す形 -->
    <PathGeometry x:Key="Icon.Viewer"
                  Figures="M3,5 H21 V19 H3 Z M14,5 V19 M16,9 H19 M16,12 H19 M16,15 H18" />

    <!--
        設定。歯車。パッケージのツールの既定の印（Icon.Tool）は放射状の線だけなので、
        こちらは歯のある輪郭にして、小さくしても見分けが付くようにしてある。
        1 行が歯 1 枚。外径 10.4・歯根 7.3・8 枚で計算して置いた。
    -->
    <PathGeometry x:Key="Icon.Settings"
                  Figures="M18.94,9.74
                           L22.24,10.19 A10.4,10.4 0 0 1 22.24,13.81 L18.94,14.26 A7.3,7.3 0 0 1 18.5,15.31
                           L20.52,17.97 A10.4,10.4 0 0 1 17.97,20.52 L15.31,18.5 A7.3,7.3 0 0 1 14.26,18.94
                           L13.81,22.24 A10.4,10.4 0 0 1 10.19,22.24 L9.74,18.94 A7.3,7.3 0 0 1 8.69,18.5
                           L6.03,20.52 A10.4,10.4 0 0 1 3.48,17.97 L5.5,15.31 A7.3,7.3 0 0 1 5.06,14.26
                           L1.76,13.81 A10.4,10.4 0 0 1 1.76,10.19 L5.06,9.74 A7.3,7.3 0 0 1 5.5,8.69
                           L3.48,6.03 A10.4,10.4 0 0 1 6.03,3.48 L8.69,5.5 A7.3,7.3 0 0 1 9.74,5.06
                           L10.19,1.76 A10.4,10.4 0 0 1 13.81,1.76 L14.26,5.06 A7.3,7.3 0 0 1 15.31,5.5
                           L17.97,3.48 A10.4,10.4 0 0 1 20.52,6.03 L18.5,8.69 A7.3,7.3 0 0 1 18.94,9.74
                           Z
                           M8.6,12.0 A3.4,3.4 0 0 1 15.4,12.0 A3.4,3.4 0 0 1 8.6,12.0 Z" />

    <!--
        パッケージのツール。マニフェストにアイコンが書かれていないときに使う既定の印。
        歯車の形で「何かを実行するもの」を表す。
    -->
    <PathGeometry x:Key="Icon.Tool"
                  Figures="M12,8.5 A3.5,3.5 0 0 1 12,15.5 A3.5,3.5 0 0 1 12,8.5
                           M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21
                           M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4
                           M18.4,5.6 L16.2,7.8 M7.8,16.2 L5.6,18.4" />

    <PathGeometry x:Key="Icon.Close" Figures="M5,5 L15,15 M15,5 L5,15" />

    <!-- リンク：枠の外に飛び出す矢印。Web のリンクにも使う。 -->
    <PathGeometry x:Key="Icon.Link" Figures="M13,4 H20 V11 M20,4 L11,13 M17,14 V20 H4 V7 H10" />

    <!-- 種類が分からないリンク：疑問符に、リンクの矢印を添えた形 -->
    <PathGeometry x:Key="Icon.Unknown"
                  Figures="M6.8,8.4 A3.3,3.3 0 1 1 10.1,11.9 V13.8 M10.1,16.9 V17
                           M15.5,3.5 H20.5 V8.5 M20.5,3.5 L15.8,8.2" />

    <!-- メール：封筒 -->
    <PathGeometry x:Key="Icon.Mail" Figures="M3,6 H21 V18 H3 Z M3.5,6.5 L12,13 L20.5,6.5" />

    <!-- フォルダー：見出しの付いた四角 -->
    <PathGeometry x:Key="Icon.Folder" Figures="M3,6 H9.5 L11.5,8.5 H21 V19 H3 Z" />

    <!-- マインドマップ：中心から 2 本の枝が伸びて子ノードにつながる形 -->
    <PathGeometry x:Key="Icon.MindMap"
                  Figures="M2,9 H8 V15 H2 Z M8,12 H12 M12,6 V18 M12,6 H16 M12,18 H16
                           M16,3.5 H22 V8.5 H16 Z M16,15.5 H22 V20.5 H16 Z" />

    <!-- 展開中に出す「小さくたたむ」印（上向き山）／たたんだときに出す「広げる」印（下向き山）。 -->
    <PathGeometry x:Key="Icon.ChevronUp" Figures="M6,15 L12,9 L18,15" />

    <PathGeometry x:Key="Icon.ChevronDown" Figures="M6,9 L12,15 L18,9" />

    <!-- 子ノードの表示・非表示。丸にマイナスが「今は出ている」、プラスが「畳んである」。 -->
    <PathGeometry x:Key="Icon.CollapseChildren"
                  Figures="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M8.5,12 H15.5" />

    <PathGeometry x:Key="Icon.ExpandChildren"
                  Figures="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M8.5,12 H15.5 M12,8.5 V15.5" />

    <!--
        リンクの絵柄。DataContext の Link を見て、行き先に合わせた見た目にする。
        ファイルへのリンクは、関連付けられたアプリのアイコン（PowerPoint・テキストなど）を出す。
        メール・フォルダー・マインドマップは、アプリ内の線画アイコンで揃える。
        Web のリンクは、行き先が特定のアプリに紐づかないので既定のリンク記号のまま。

        ノードの脇とビューアの両方で使うので、絵柄だけを切り出してある
        （見た目を 2 か所に書くと、片方だけ直して食い違うため）。
    -->
    <Style x:Key="LinkGlyph" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- 大きめのアイコンを縮めて描くので、高解像度の画面でもぼやけにくい。 -->
                        <Image x:Name="ShellIcon"
                               Source="{Binding Link, Converter={StaticResource LinkIcon}}"
                               Width="18"
                               Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <Path x:Name="Glyph"
                              Data="{StaticResource Icon.Link}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="#2F80ED"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 種類ごとの線画に差し替える。ここに無い種類は記号のまま。 -->
                        <DataTrigger Binding="{Binding Link, Converter={StaticResource LinkKind}}"
                                     Value="{x:Static svc:LinkKind.MindMap}">
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.MindMap}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Link, Converter={StaticResource LinkKind}}"
                                     Value="{x:Static svc:LinkKind.Unknown}">
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Unknown}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Link, Converter={StaticResource LinkKind}}"
                                     Value="{x:Static svc:LinkKind.Mail}">
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Mail}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Link, Converter={StaticResource LinkKind}}"
                                     Value="{x:Static svc:LinkKind.Folder}">
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Folder}" />
                        </DataTrigger>
                        <!-- アプリのアイコンを引けなかったリンクは、線画の方を見せる。 -->
                        <Trigger SourceName="ShellIcon" Property="Source" Value="{x:Null}">
                            <Setter TargetName="ShellIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ノードのタイトル脇に出すリンクボタン。絵柄だけで、ラベルは付けない。 -->
    <Style x:Key="NodeLinkButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentControl Style="{StaticResource LinkGlyph}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#E4EEFC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ビューアで中身を出せなかったときに添える「リンク先を開く」ボタン。
        絵柄はノードの脇と同じものを使い、どこへ飛ぶのかが見た目で分かるようにする。
        こちらは枠の中に置くので、絵柄の右にラベルを並べる。
    -->
    <Style x:Key="ViewerLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#2F80ED" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#C3CBD5"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LinkGlyph}" VerticalAlignment="Center" />
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#E4EEFC" />
                            <Setter TargetName="Backdrop" Property="BorderBrush" Value="#2F80ED" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#D3E3FA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ノードのタイトル脇に出す、表示の大小を切り替えるボタン。
        DataContext のノードの IsCollapsed に応じて山の向きを変える
        （展開中は上向き＝たたむ、たたみ中は下向き＝広げる）。
    -->
    <Style x:Key="NodeToggleButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <Path x:Name="Glyph"
                              Data="{StaticResource Icon.ChevronUp}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="#8A94A0"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.ChevronDown}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#DDE3EA" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="#3C4652" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        子ノードの表示・非表示を切り替えるボタン。
        NodeToggleButton とほとんど同じだが、見ている欄（IsCollapsed / AreChildrenHidden）と
        字が違う。トリガーの中で切り替える欄を差し替えられないので、style ごと分けてある。
    -->
    <Style x:Key="NodeChildrenToggleButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <Path x:Name="Glyph"
                              Data="{StaticResource Icon.CollapseChildren}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="#8A94A0"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding AreChildrenHidden}" Value="True">
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.ExpandChildren}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#DDE3EA" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="#3C4652" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ツールバーのアイコン。ボタンが無効なときは一緒に淡くする。 -->
    <Style x:Key="ToolBarIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="#3C4652" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                         Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ツールチップの見た目（白地・黒枠・黒文字）。キーを付けず全ツールチップ共通にする。
        標準のツールチップを使うので、遅延・ちらつき防止・マウス追従は WPF に任せられる。
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <!--
        ツールバーのボタン。アイコンは Tag に、ラベルは Content に入れる。
        ラベルは脇に常時出さず、ホバー時にツールチップとして出す。
        ToolBar は中のボタンに専用のスタイルを当てるので、それを継承しないと
        ツールバーらしい見た目が失われる。各ボタンで明示的に指定して使う。
    -->
    <Style x:Key="ToolBarButton"
           TargetType="Button"
           BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <!-- ラベル（Content）をそのままツールチップの文言にする。 -->
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <!--
            マウスの位置を基準に、その少し上へ出す。
            InitialShowDelay で「乗せてから出るまで」の遅延を入れ、
            BetweenShowDelay を長めに取ることで、ボタン間を移動したときの点滅を抑える。
            ShowDuration は読んでいる間に消えないよう長めにする。
        -->
        <Setter Property="ToolTipService.Placement" Value="Mouse" />
        <Setter Property="ToolTipService.VerticalOffset" Value="-30" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="450" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- 表示はアイコンだけ。ラベルはホバー時のツールチップに任せる。 -->
                    <Path Style="{StaticResource ToolBarIcon}"
                          Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タブを閉じるボタン。ふだんは控えめに、ホバーで背景を出す。 -->
    <Style x:Key="TabCloseButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Backdrop"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <Path x:Name="Glyph"
                              Data="{StaticResource Icon.Close}"
                              Width="9"
                              Height="9"
                              Stretch="Uniform"
                              Stroke="#8A94A0"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#DDE3EA" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="#3C4652" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#C3CBD5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ツールバーの入切ボタン。アイコンとラベルの扱いは ToolBarButton と同じで、
        入っているかどうかは ToolBar 既定の見た目（押し込み）に任せる。
    -->
    <Style x:Key="ToolBarToggleButton"
           TargetType="ToggleButton"
           BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.Placement" Value="Mouse" />
        <Setter Property="ToolTipService.VerticalOffset" Value="-30" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="450" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Style="{StaticResource ToolBarIcon}"
                          Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ビューアの見出しにある、本文とリンク先を切り替えるボタン。選んだ側を塗って示す。 -->
    <Style x:Key="ViewerTabButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#5B6673" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Backdrop"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#E4EEFC" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#2F80ED" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
