<Window x:Class="MindMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MindMap.Converters"
        xmlns:local="clr-namespace:MindMap"
        xmlns:vm="clr-namespace:MindMap.ViewModels"
        Title="{Binding Title}"
        Width="1280"
        Height="760"
        WindowStartupLocation="CenterScreen"
        FontSize="13">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <conv:EmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
        <conv:ToolIconConverter x:Key="ToolIcon" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseActiveDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ActiveDocument.SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding ActiveDocument.SaveAsCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Alt" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding ActiveDocument.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding ActiveDocument.RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding ActiveDocument.RedoCommand}" />
        <!-- 編集中はコマンドが無効になるので、キーはそのままテキストボックスに届く -->
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding ActiveDocument.CutCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding ActiveDocument.CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding ActiveDocument.PasteCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding ActiveDocument.SelectAllCommand}" />
        <KeyBinding Key="Tab" Command="{Binding ActiveDocument.AddChildCommand}" />
        <KeyBinding Key="Insert" Command="{Binding ActiveDocument.AddChildCommand}" />
        <KeyBinding Key="Return" Command="{Binding ActiveDocument.AddSiblingCommand}" />
        <KeyBinding Key="Delete" Command="{Binding ActiveDocument.DeleteNodeCommand}" />
        <KeyBinding Key="F2" Command="{Binding ActiveDocument.BeginEditCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ActiveDocument.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ActiveDocument.ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ActiveDocument.ResetZoomCommand}" />
        <KeyBinding Key="F7" Command="{Binding Viewer.ToggleCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <!--
                ボタンのラベルはホバー時にツールチップとして出す（脇には常時出さない）。
                文言はツールチップ側で Content から拾うので、ここには ToolTip を書かない。
                キー操作は各ボタンの意味が分かるよう、ラベルの末尾に併記しておく。
            -->
            <ToolBar>
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding NewDocumentCommand}"
                        Tag="{StaticResource Icon.New}"
                        Content="新規 (Ctrl+N)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding OpenDocumentCommand}"
                        Tag="{StaticResource Icon.Open}"
                        Content="開く (Ctrl+O)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.SaveCommand}"
                        Tag="{StaticResource Icon.Save}"
                        Content="保存 (Ctrl+S)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.SaveAsCommand}"
                        Tag="{StaticResource Icon.SaveAs}"
                        Content="名前を付けて保存 (Ctrl+Shift+S)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding SaveAllCommand}"
                        Tag="{StaticResource Icon.SaveAll}"
                        Content="すべて保存 (Ctrl+Alt+S)" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.UndoCommand}"
                        Tag="{StaticResource Icon.Undo}"
                        Content="元に戻す (Ctrl+Z)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.RedoCommand}"
                        Tag="{StaticResource Icon.Redo}"
                        Content="やり直し (Ctrl+Y)" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.CutCommand}"
                        Tag="{StaticResource Icon.Cut}"
                        Content="切り取り (Ctrl+X)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.CopyCommand}"
                        Tag="{StaticResource Icon.Copy}"
                        Content="コピー (Ctrl+C)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.PasteCommand}"
                        Tag="{StaticResource Icon.Paste}"
                        Content="貼り付け (Ctrl+V)" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.AddChildCommand}"
                        Tag="{StaticResource Icon.AddChild}"
                        Content="子ノード (Tab)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.AddSiblingCommand}"
                        Tag="{StaticResource Icon.AddSibling}"
                        Content="兄弟ノード (Enter)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.BeginEditCommand}"
                        Tag="{StaticResource Icon.Edit}"
                        Content="編集 (F2)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.DeleteNodeCommand}"
                        Tag="{StaticResource Icon.Delete}"
                        Content="削除 (Delete)" />
                <Separator />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ZoomOutCommand}"
                        Tag="{StaticResource Icon.ZoomOut}"
                        Content="縮小 (Ctrl+-)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ResetZoomCommand}"
                        Tag="{StaticResource Icon.ZoomReset}"
                        Content="等倍に戻す (Ctrl+0)" />
                <Button Style="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ZoomInCommand}"
                        Tag="{StaticResource Icon.ZoomIn}"
                        Content="拡大 (Ctrl++)" />
                <Separator />
                <!--
                    パッケージが足したツール。1 つも入っていなければ、ここには何も出ない
                    （前後の区切り線も含めて、ツールバーの見た目は素の状態と同じになる）。
                    ショートカットはマニフェスト側に書かれているので、
                    キー操作の登録は MainWindow.xaml.cs で行う。
                -->
                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MapToolViewModel}">
                            <Button Style="{StaticResource ToolBarButton}"
                                    Command="{Binding Command}"
                                    ToolTip="{Binding ToolTip}"
                                    Tag="{Binding Icon, Converter={StaticResource ToolIcon}}"
                                    Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Visibility="{Binding Tools.Count, Converter={StaticResource NotEmptyToVis}}" />

                <!--
                    ビューアの開閉。入っているかどうかを見せたいのでボタンではなく入切にする。
                    ツールより右に置くのは、本体の表示切り替えであって、
                    パッケージが増えても位置が変わらない場所に居てほしいため。
                -->
                <ToggleButton Style="{StaticResource ToolBarToggleButton}"
                              IsChecked="{Binding Viewer.IsVisible, Mode=TwoWay}"
                              Tag="{StaticResource Icon.Viewer}"
                              Content="ビューア (F7)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <!-- ツールが動いている間と、終わったあとは、案内より結果を優先して出す。 -->
                <Grid>
                    <TextBlock Foreground="#666"
                               Text="ドラッグで移動 / ダブルクリックで編集 / Ctrl+クリックや余白のドラッグで複数選択 / Ctrl+Enter で確定 / Ctrl+ホイールで拡大縮小"
                               Visibility="{Binding ActiveDocument.ToolStatus, Converter={StaticResource EmptyToVis}}" />
                    <TextBlock Foreground="#444"
                               FontWeight="SemiBold"
                               Text="{Binding ActiveDocument.ToolStatus}" />
                </Grid>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#666"
                               Margin="0,0,12,0"
                               Text="{Binding ActiveDocument.SelectedNodes.Count, StringFormat={}{0} 個選択}" />
                    <TextBlock Foreground="#666" Text="{Binding ActiveDocument.Zoom, StringFormat={}{0:P0}}" />
                    <TextBlock Foreground="#666"
                               Margin="12,0,0,0"
                               Text="{Binding ActiveDocument.CurrentFilePath, TargetNullValue=未保存}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!--
            ビューア。選択中のノードの本文か、リンク先のファイルを右側に出す。
            間の細い帯はドラッグで幅を変えるためのもので、たたんでいる間は帯ごと消す。
            DockPanel は先に置いたものから外側に付くので、ビューア・帯・タブの順に並べる。
        -->
        <local:ViewerPane DockPanel.Dock="Right"
                          DataContext="{Binding Viewer}"
                          Width="{Binding Width}"
                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />

        <Border DockPanel.Dock="Right"
                Width="6"
                Background="Transparent"
                Cursor="SizeWE"
                Visibility="{Binding Viewer.IsVisible, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="ViewerSplitter_MouseLeftButtonDown"
                MouseMove="ViewerSplitter_MouseMove"
                MouseLeftButtonUp="ViewerSplitter_MouseLeftButtonUp" />

        <TabControl ItemsSource="{Binding Documents}"
                    SelectedItem="{Binding ActiveDocument}"
                    Padding="0"
                    BorderThickness="0,1,0,0">

            <!-- タブの見出し。ファイル名と、閉じるための × ボタン。 -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,7" />
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button Style="{StaticResource TabCloseButton}"
                                ToolTip="このタブを閉じる (Ctrl+W)"
                                Command="{Binding DataContext.CloseDocumentCommand,
                                                  RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- タブの中身。ドキュメントごとに同じキャンバスを描く。 -->
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#F4F6F8"
                                  DataContextChanged="Scroller_DataContextChanged"
                                  ScrollChanged="Scroller_ScrollChanged"
                                  PreviewMouseWheel="Scroller_PreviewMouseWheel"
                                  PreviewMouseDown="Scroller_PreviewMouseDown"
                                  PreviewMouseMove="Scroller_PreviewMouseMove"
                                  PreviewMouseUp="Scroller_PreviewMouseUp">
                        <!-- キャンバスは固定サイズ。スクロールで広い領域を使う。
                             拡大縮小は LayoutTransform で行う（RenderTransform だとスクロール範囲が拡大率に追従しない）。 -->
                        <Grid x:Name="CanvasRoot"
                              Width="3000"
                              Height="2000"
                              Background="Transparent"
                              AllowDrop="True"
                              MouseLeftButtonDown="CanvasRoot_MouseLeftButtonDown"
                              MouseMove="CanvasRoot_MouseMove"
                              MouseLeftButtonUp="CanvasRoot_MouseLeftButtonUp"
                              DragOver="CanvasRoot_DragOver"
                              Drop="CanvasRoot_Drop">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            </Grid.LayoutTransform>

                            <!-- 接続線はノードより下に描く -->
                            <ItemsControl ItemsSource="{Binding Connections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                                        <Line X1="{Binding X1}"
                                              Y1="{Binding Y1}"
                                              X2="{Binding X2}"
                                              Y2="{Binding Y2}"
                                              Stroke="#9AA5B1"
                                              StrokeThickness="2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <!-- 選択中のノードは重なり順を上げ、他のノードに隠れないようにする。
                                             選択は常に 1 つだけなので、最前面に来るのはそのノードだけ。 -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="1000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                        <!-- 幅・高さは指定せず中身に合わせる。MaxWidth を超えたぶんは折り返す。 -->
                                        <Border MinWidth="120"
                                                MaxWidth="320"
                                                MinHeight="48"
                                                CornerRadius="8"
                                                Background="White"
                                                Cursor="SizeAll"
                                                AllowDrop="True"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                SizeChanged="Node_SizeChanged"
                                                MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                                MouseMove="Node_MouseMove"
                                                MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                                PreviewMouseRightButtonDown="Node_PreviewMouseRightButtonDown"
                                                DragOver="Node_DragOver"
                                                Drop="Node_Drop">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <!-- 切り取り・コピー・貼り付けはドキュメント側のコマンド。
                                                         ContextMenu は visual tree の外にいるので、
                                                         開く元の Border に持たせたウィンドウの ViewModel から辿る。 -->
                                                    <MenuItem Header="切り取り"
                                                              InputGestureText="Ctrl+X"
                                                              Command="{Binding PlacementTarget.Tag.ActiveDocument.CutCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="コピー"
                                                              InputGestureText="Ctrl+C"
                                                              Command="{Binding PlacementTarget.Tag.ActiveDocument.CopyCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="貼り付け（この下に）"
                                                              InputGestureText="Ctrl+V"
                                                              Command="{Binding PlacementTarget.Tag.ActiveDocument.PasteCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <!-- 子ノードを別ファイルへ切り出す。子がいなければ切り出すものが無い。 -->
                                                    <MenuItem Header="子ノードを別のファイルに保存..."
                                                              IsEnabled="{Binding HasChildren}"
                                                              Click="ContextExtractChildren_Click" />
                                                    <Separator />
                                                    <MenuItem Header="リンクを開く"
                                                              IsEnabled="{Binding HasLink}"
                                                              Click="ContextOpenLink_Click" />
                                                    <Separator />
                                                    <MenuItem Header="ファイルを選んでリンク..."
                                                              Click="ContextSetFileLink_Click" />
                                                    <MenuItem Header="リンクを削除"
                                                              IsEnabled="{Binding HasLink}"
                                                              Click="ContextRemoveLink_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#C3CBD5" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#2F80ED" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid Margin="12,8">
                                                <!-- 表示：タイトルは中央、内容は左寄せ。内容が空なら区切り線ごと省く。 -->
                                                <StackPanel VerticalAlignment="Center"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <!-- タイトルの右に、リンクアイコンと表示の大小を切り替えるアイコンが並ぶ。
                                                         どちらも出ないときは右の 2 列が幅 0 になり、タイトルは中央のままになる。 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource NodeLinkButton}"
                                                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding Link}"
                                                                Command="{Binding DataContext.OpenLinkCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <!-- 本文があるノードだけ、大小を切り替えるボタンを出す。
                                                             タイトルだけのノードにはたたむものがないので出さない。 -->
                                                        <Button Grid.Column="2"
                                                                Margin="2,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource NodeToggleButton}"
                                                                Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="表示の大小を切り替え（タイトルのみ／本文つき）"
                                                                Command="{Binding DataContext.ToggleCollapseCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                    <Border Height="1"
                                                            Margin="0,6"
                                                            Background="#E3E8EE"
                                                            Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Body}"
                                                               TextAlignment="Left"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="#5B6673"
                                                               Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- 編集：タイトル欄は 1 行のみ。Enter で内容欄に移る。
                                                     フォーカスが 2 つの欄の間を移る間は編集を続け、外に出たら確定する。 -->
                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                            IsKeyboardFocusWithinChanged="EditPanel_IsKeyboardFocusWithinChanged">
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="96"
                                                             AcceptsReturn="False"
                                                             TextAlignment="Center"
                                                             FontWeight="SemiBold"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             IsVisibleChanged="TitleBox_IsVisibleChanged"
                                                             PreviewKeyDown="EditBox_PreviewKeyDown" />
                                                    <Border Height="1" Margin="0,6" Background="#E3E8EE" />
                                                    <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="96"
                                                             MinHeight="32"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             TextAlignment="Left"
                                                             FontSize="12"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             PreviewKeyDown="EditBox_PreviewKeyDown" />

                                                    <!-- リンク欄。本文から Tab で移れる。 -->
                                                    <Border Height="1" Margin="0,6" Background="#E3E8EE" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource Icon.Link}"
                                                              Width="11"
                                                              Height="11"
                                                              Margin="0,0,5,0"
                                                              Stretch="Uniform"
                                                              Stroke="#8A94A0"
                                                              StrokeThickness="1.7"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinWidth="96"
                                                                 FontSize="11"
                                                                 Foreground="#5B6673"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 ToolTip="URL やファイルのパス（ブラウザーやエクスプローラーからのドラッグ、右クリックでも設定できます）"
                                                                 PreviewKeyDown="EditBox_PreviewKeyDown" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 範囲選択の枠。余白をドラッグしている間だけ出す。
                                 ノードのクリックを邪魔しないよう、当たり判定は持たせない。 -->
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="SelectionBox"
                                           Visibility="Collapsed"
                                           Fill="#282F80ED"
                                           Stroke="#2F80ED"
                                           StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>


